{
  "Assertions": {
    "Description": "Every claim in the ledger: definitions, theorems, finite verifications, hypotheses and falsified attempts.",
    "schema": [
      {
        "name": "AssertionId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "AssertionId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{AssertionId}}"
      },
      {
        "name": "Statement",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Statement"
      },
      {
        "name": "ReportedStatus",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "ReportedStatus"
      },
      {
        "name": "ProofSection",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "ProofSection"
      },
      {
        "name": "IsUsable",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "IsUsable",
        "formula": "=IF(OR({{ReportedStatus}}=\"DEFINITION\",{{ReportedStatus}}=\"PROVED_HUMAN_READABLE\",{{ReportedStatus}}=\"REDERIVED_KNOWN\",{{ReportedStatus}}=\"FINITE_VERIFIED\"),1,0)"
      },
      {
        "name": "IsProofEligible",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "IsProofEligible",
        "formula": "=IF(OR({{ReportedStatus}}=\"DEFINITION\",{{ReportedStatus}}=\"PROVED_HUMAN_READABLE\",{{ReportedStatus}}=\"REDERIVED_KNOWN\"),1,0)"
      }
    ]
  },
  "Dependencies": {
    "Description": "Declared one-step logical dependencies between assertions.",
    "schema": [
      {
        "name": "DependencyId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "DependencyId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{DependencyId}}"
      },
      {
        "name": "Conclusion",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The assertion that depends on the premise.",
        "RelatedTo": "Assertions"
      },
      {
        "name": "Premise",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The assertion the conclusion relies on.",
        "RelatedTo": "Assertions"
      }
    ]
  },
  "Prerequisites": {
    "Description": "Transitive closure of Dependencies, one row per (conclusion, ancestor), regenerated by research/loop_tools.py.",
    "schema": [
      {
        "name": "PrerequisiteId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "PrerequisiteId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{PrerequisiteId}}"
      },
      {
        "name": "ConclusionKey",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The assessment this transitive premise feeds.",
        "RelatedTo": "Assessments"
      },
      {
        "name": "Premise",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "A transitive ancestor of the conclusion (including itself).",
        "RelatedTo": "Assertions"
      },
      {
        "name": "PremiseUsable",
        "datatype": "integer",
        "type": "lookup",
        "nullable": false,
        "Description": "PremiseUsable",
        "formula": "=INDEX(Assertions!{{IsUsable}},MATCH({{Premise}},Assertions!{{AssertionId}},0))"
      },
      {
        "name": "PremiseProofEligible",
        "datatype": "integer",
        "type": "lookup",
        "nullable": false,
        "Description": "PremiseProofEligible",
        "formula": "=INDEX(Assertions!{{IsProofEligible}},MATCH({{Premise}},Assertions!{{AssertionId}},0))"
      },
      {
        "name": "Blocked",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "Blocked",
        "formula": "=1-{{PremiseUsable}}"
      },
      {
        "name": "ProofBlocked",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "ProofBlocked",
        "formula": "=1-{{PremiseProofEligible}}"
      }
    ]
  },
  "Assessments": {
    "Description": "Compiled status of each assertion given the status of all its ancestors.",
    "schema": [
      {
        "name": "AssessmentId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "AssessmentId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{AssessmentId}}"
      },
      {
        "name": "Assertion",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The assertion being assessed.",
        "RelatedTo": "Assertions"
      },
      {
        "name": "ReportedStatus",
        "datatype": "string",
        "type": "lookup",
        "nullable": false,
        "Description": "ReportedStatus",
        "formula": "=INDEX(Assertions!{{ReportedStatus}},MATCH({{Assertion}},Assertions!{{AssertionId}},0))"
      },
      {
        "name": "BlockedCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "BlockedCount",
        "formula": "=SUMIFS(Prerequisites!{{Blocked}},Prerequisites!{{ConclusionKey}},{{Assertion}})"
      },
      {
        "name": "ProofBlockedCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "ProofBlockedCount",
        "formula": "=SUMIFS(Prerequisites!{{ProofBlocked}},Prerequisites!{{ConclusionKey}},{{Assertion}})"
      },
      {
        "name": "CurrentStatus",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "CurrentStatus",
        "formula": "=IF({{BlockedCount}}>0,\"BLOCKED\",{{ReportedStatus}})"
      },
      {
        "name": "ProofEligible",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "ProofEligible",
        "formula": "=IF({{ProofBlockedCount}}=0,1,0)"
      },
      {
        "name": "SupportCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "Number of evidence files linked to this assertion.",
        "formula": "=COUNTIFS(EvidenceLinks!{{Assertion}},{{Assertion}})"
      },
      {
        "name": "EvidenceGap",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "1 when a FINITE_VERIFIED claim has no linked evidence file.",
        "formula": "=IF(AND({{ReportedStatus}}=\"FINITE_VERIFIED\",{{SupportCount}}=0),1,0)"
      },
      {
        "name": "ProjectKey",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "Dashboard this assessment rolls up to.",
        "RelatedTo": "Dashboards"
      }
    ]
  },
  "Evidence": {
    "Description": "Files produced by experiments, with sha256 hashes computed from disk.",
    "schema": [
      {
        "name": "EvidenceId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "EvidenceId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{EvidenceId}}"
      },
      {
        "name": "Path",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Path"
      },
      {
        "name": "Sha256",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Sha256"
      }
    ]
  },
  "Revisions": {
    "Description": "Every status change, with the prior status kept visible.",
    "schema": [
      {
        "name": "RevisionId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "RevisionId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{RevisionId}}"
      },
      {
        "name": "Assertion",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The assertion whose status changed.",
        "RelatedTo": "Assertions"
      },
      {
        "name": "PriorStatus",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "PriorStatus"
      },
      {
        "name": "NewStatus",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "NewStatus"
      },
      {
        "name": "Reason",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Reason"
      },
      {
        "name": "Replacement",
        "datatype": "string",
        "type": "relationship",
        "nullable": true,
        "Description": "Claim that replaces a falsified one, if any.",
        "RelatedTo": "Assertions"
      }
    ]
  },
  "Loops": {
    "Description": "Research loops. Only Kind EFFORTLESS + State VERIFIED rows carry build receipts and hashes.",
    "schema": [
      {
        "name": "LoopId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "LoopId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{LoopId}}"
      },
      {
        "name": "Kind",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Kind"
      },
      {
        "name": "State",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "State"
      },
      {
        "name": "BuildReceipt",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "BuildReceipt"
      },
      {
        "name": "InputHash",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "InputHash"
      },
      {
        "name": "OutputHash",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "OutputHash"
      },
      {
        "name": "ProjectKey",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "Dashboard this loop rolls up to.",
        "RelatedTo": "Dashboards"
      },
      {
        "name": "Hypothesis",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "The hypothesis this loop tested, as stated before the experiment."
      },
      {
        "name": "Summary",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "What the loop changed in the hub and what the build showed."
      }
    ]
  },
  "Dashboards": {
    "Description": "Project-level rollups.",
    "schema": [
      {
        "name": "DashboardId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "DashboardId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{DashboardId}}"
      },
      {
        "name": "ClaimCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "ClaimCount",
        "formula": "=COUNTIFS(Assessments!{{ProjectKey}},{{DashboardId}})"
      },
      {
        "name": "BlockedCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "BlockedCount",
        "formula": "=COUNTIFS(Assessments!{{ProjectKey}},{{DashboardId}},Assessments!{{CurrentStatus}},\"BLOCKED\")"
      },
      {
        "name": "CompletedNativeLoops",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "CompletedNativeLoops",
        "formula": "=COUNTIFS(Loops!{{ProjectKey}},{{DashboardId}},Loops!{{Kind}},\"EFFORTLESS\",Loops!{{State}},\"VERIFIED\")"
      },
      {
        "name": "EvidenceGapCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "Finite-verified claims with no linked evidence.",
        "formula": "=SUMIFS(Assessments!{{EvidenceGap}},Assessments!{{ProjectKey}},{{DashboardId}})"
      }
    ]
  },
  "EvidenceLinks": {
    "Description": "Which evidence file supports which assertion. One row per (evidence, assertion) pair.",
    "schema": [
      {
        "name": "EvidenceLinkId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "EvidenceId-AssertionId."
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Display alias.",
        "formula": "={{EvidenceLinkId}}"
      },
      {
        "name": "Evidence",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The evidence file.",
        "RelatedTo": "Evidence"
      },
      {
        "name": "Assertion",
        "datatype": "string",
        "type": "relationship",
        "nullable": false,
        "Description": "The assertion it supports.",
        "RelatedTo": "Assertions"
      }
    ]
  }
}