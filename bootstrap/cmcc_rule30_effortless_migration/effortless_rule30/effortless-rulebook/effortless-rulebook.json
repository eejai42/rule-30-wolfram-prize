        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "BlockedCount",
        "formula": "=SUMIFS(Prerequisites!{{Blocked}},Prerequisites!{{ConclusionKey}},{{Assertion}})"
      },
      {
        "name": "ProofBlockedCount",
        "datatype": "integer",
        "type": "aggregation",
        "nullable": false,
        "Description": "ProofBlockedCount",
        "formula": "=SUMIFS(Prerequisites!{{ProofBlocked}},Prerequisites!{{ConclusionKey}},{{Assertion}})"
      },
      {
        "name": "CurrentStatus",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "CurrentStatus",
        "formula": "=IF({{BlockedCount}}>0,\"BLOCKED\",{{ReportedStatus}})"
      },
      {
        "name": "ProofEligible",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "ProofEligible",
        "formula": "=IF({{ProofBlockedCount}}=0,1,0)"
      },
      {
        "name": "ProjectKey",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "ProjectKey"
      }
