{
  "$schema": "https://example.com/cmcc-schema/v1",
  "Name": "Rule30Research",
  "Description": "Research provenance and dependency-aware assessments. Human-readable proofs remain imported assertions, not formal certificates.",
  "Assertions": {
    "Description": "Assertions",
    "schema": [
      {
        "name": "AssertionId",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "AssertionId"
      },
      {
        "name": "Name",
        "datatype": "string",
        "type": "calculated",
        "nullable": false,
        "Description": "Name",
        "formula": "={{AssertionId}}"
      },
      {
        "name": "Statement",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Statement"
      },
      {
        "name": "ReportedStatus",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "ReportedStatus"
      },
      {
        "name": "ProofSection",
        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "ProofSection"
      },
      {
        "name": "IsUsable",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "IsUsable",
        "formula": "=IF(OR({{ReportedStatus}}=\"DEFINITION\",{{ReportedStatus}}=\"PROVED_HUMAN_READABLE\",{{ReportedStatus}}=\"REDERIVED_KNOWN\",{{ReportedStatus}}=\"FINITE_VERIFIED\"),1,0)"
      },
      {
        "name": "IsProofEligible",
        "datatype": "integer",
        "type": "calculated",
        "nullable": false,
        "Description": "IsProofEligible",
        "formula": "=IF(OR({{ReportedStatus}}=\"DEFINITION\",{{ReportedStatus}}=\"PROVED_HUMAN_READABLE\",{{ReportedStatus}}=\"REDERIVED_KNOWN\"),1,0)"
      }
    ],
    "data": [
      {
        "AssertionId": "D0",
        "Statement": "Single seed, infinite lattice, Rule 30, time starts at zero.",
        "ReportedStatus": "DEFINITION",
        "ProofSection": ""
      },
      {
        "AssertionId": "T0",
        "Statement": "Cone support and both boundary cells equal one.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "2; original THEOREM_004.md"
      },
      {
        "AssertionId": "T004",
        "Statement": "Fixed diagonal k has period dividing 2^k.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "3"
      },
      {
        "AssertionId": "TA",
        "Statement": "Least antiderivative period is Q or 2Q according to forcing parity.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "3"
      },
      {
        "AssertionId": "TB",
        "Statement": "First diagonal one occurs at ceil(k/2); least period exceeds that time.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "3"
      },
      {
        "AssertionId": "TC",
        "Statement": "For every T,p a mismatch occurs in column 0 or 1 by t=2T+p.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "4"
      },
      {
        "AssertionId": "TD",
        "Statement": "Constant center runs obey the proved endpoint bounds.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "5"
      },
      {
        "AssertionId": "K1",
        "Statement": "The center is not eventually constant.",
        "ReportedStatus": "REDERIVED_KNOWN",
        "ProofSection": "5"
      },
      {
        "AssertionId": "TE",
        "Statement": "Generic n-step output is XOR-affine in its extreme-left input.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "6"
      },
      {
        "AssertionId": "CM",
        "Statement": "Time-indexed CMCC equations uniquely reproduce Rule 30.",
        "ReportedStatus": "PROVED_HUMAN_READABLE",
        "ProofSection": "7"
      },
      {
        "AssertionId": "F1",
        "Statement": "All supplied numerical outputs reproduced.",
        "ReportedStatus": "FINITE_VERIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "F2",
        "Statement": "Exact diagonal periods certified through offset 51.",
        "ReportedStatus": "FINITE_VERIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "F3",
        "Statement": "100001 center bits checked twice; periods 1..10000 excluded for onsets through 90000.",
        "ReportedStatus": "FINITE_VERIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "F4",
        "Statement": "33411 SQLite cells match independent evolution.",
        "ReportedStatus": "FINITE_VERIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "H1",
        "Statement": "All diagonals k>=1 are balanced over their least period.",
        "ReportedStatus": "FALSIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "H2",
        "Statement": "Periods double at every k>=3.",
        "ReportedStatus": "FALSIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "H3",
        "Statement": "Cone support, first arrival and unbounded diagonal periods imply aperiodic moving diagonal.",
        "ReportedStatus": "FALSIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "H4",
        "Statement": "Least diagonal periods never decrease.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      },
      {
        "AssertionId": "H5",
        "Statement": "ACID alone implies transaction-order independence.",
        "ReportedStatus": "FALSIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "H6",
        "Statement": "Scalar aggregation results may always be nested without preserving group weights.",
        "ReportedStatus": "FALSIFIED",
        "ProofSection": ""
      },
      {
        "AssertionId": "B1",
        "Statement": "Periodic center of every p>=2 forces a contradiction with seed-compatible neighboring columns.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      },
      {
        "AssertionId": "B2",
        "Statement": "Uniform sublinear center discrepancy bound.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      },
      {
        "AssertionId": "B3",
        "Statement": "Uniform machine-model lower bound with agreed asymptotic quantifiers.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      },
      {
        "AssertionId": "P1",
        "Statement": "The Rule 30 center is not eventually periodic.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      },
      {
        "AssertionId": "P2",
        "Statement": "The center has limiting frequency one-half.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      },
      {
        "AssertionId": "P3",
        "Statement": "The official computational-effort conjecture, once model and quantifiers are fixed.",
        "ReportedStatus": "OPEN",
        "ProofSection": ""
      }
    ]
  },
