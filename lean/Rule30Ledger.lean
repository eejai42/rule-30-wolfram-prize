import Rule30PrizeKit
import Ruliology
import Mathlib.Dynamics.PeriodicPts.Defs

/-!
# The Rule 30 research ledger, in Lean

GENERATED by research/lean/ledger.py from the compiled rulebook. Do not edit: change a claim's term tree
(research/hub/build_model.py, formal_claims.py) or its proof (research/lean/proofs.py) and build.

Every theorem `claim_<id>` states one ledger claim, written by the build from the claim's term tree
(Assertions.LeanStatement). A theorem proved by `sorry` is an open Lean obligation: the kit's Check.lean
rejects it, so the claim does not count as Lean-verified. `official_<id>` states that a prize problem's
formal statement here is equivalent to the official one in the kit.

The vocabulary below gives the model's operators their meaning in terms of the kit's `cell`, `R` and `D`.
-/

namespace Rule30Ledger

open Ruliology.CellularAutomata

/-- A cell as the model holds it: 1 for black, 0 for white. -/
def bit (b : Bool) : Nat := if b then 1 else 0

/-- x(i, t): the cell at position i after t steps. -/
def x (i : Int) (t : Nat) : Nat := bit (Rule30Jen.cell t i)

/-- c(t): the center column. -/
def c (t : Nat) : Nat := bit (Rule30Prize.center t)

/-- y_k(t) = x(t - k, t): the k-th diagonal from the right edge (the kit's R). -/
def y (k t : Nat) : Nat := bit (Rule30Diagonals.R k t)

/-- w_k(t) = x(k - t, t): the k-th diagonal from the left edge (the kit's D). -/
def w (k t : Nat) : Nat := bit (Rule30Diagonals.D k t)

/-- Rule 30 on 0/1 cells: l XOR (q OR r). -/
def rule30 (l q r : Nat) : Nat := bit (Rule30Jen.rule (l == 1) (q == 1) (r == 1))

def Power (a b : Nat) : Nat := a ^ b
def Mod (a b : Nat) : Nat := a % b
def bxor (a b : Nat) : Nat := bit ((a == 1) ^^ (b == 1))
def bor (a b : Nat) : Nat := bit ((a == 1) || (b == 1))

/-- The time shift on sequences. -/
def shift (f : Nat → Nat) : Nat → Nat := fun t => f (t + 1)

/-- P k: the least period of the right diagonal y_k. -/
noncomputable def P (k : Nat) : Nat := Function.minimalPeriod shift (y k)

/-- Eps k: 1 when the least period doubles at k. -/
noncomputable def Eps (k : Nat) : Nat := if P k = 2 * P (k - 1) then 1 else 0

theorem bit_inj {a b : Bool} : bit a = bit b ↔ a = b := by cases a <;> cases b <;> simp [bit]
theorem bit_eq_one {a : Bool} : bit a = 1 ↔ a = true := by cases a <;> simp [bit]
theorem bit_eq_zero {a : Bool} : bit a = 0 ↔ a = false := by cases a <;> simp [bit]
theorem bit_beq_one (a : Bool) : (bit a == 1) = a := by cases a <;> rfl

theorem iterate_shift (f : Nat → Nat) (n : Nat) : shift^[n] f = fun t => f (t + n) := by
  induction n generalizing f with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply, ih]
    funext t
    simp only [shift]
    congr 1
    all_goals omega

/-- D0. -/
theorem claim_D0 : ((((x 0 0) = 1) ∧ (∀ i : Int, (i ≠ 0) → ((x i 0) = 0))) ∧ (∀ t : Nat, (t ≥ 0) → (∀ i : Int, True → ((x i (t + 1)) = (rule30 (x (i - 1) t) (x i t) (x (i + 1) t)))))) :=
  by
    refine ⟨⟨by simp [x, bit, Rule30Jen.cell], fun i hi => by simp [x, bit, Rule30Jen.cell, hi]⟩, fun t _ i _ => ?_⟩
    show bit (Rule30Jen.cell (t + 1) i) = rule30 (bit (Rule30Jen.cell t (i - 1))) (bit (Rule30Jen.cell t i)) (bit (Rule30Jen.cell t (i + 1)))
    rw [Rule30Jen.cell]
    simp only [rule30, bit_beq_one]

/-- T0. -/
theorem claim_T0 : (∀ t : Nat, (t ≥ 0) → (((x (0 - t) t) = 1) ∧ ((x t t) = 1))) :=
  by
    intro t _
    refine ⟨?_, ?_⟩
    · simp [x, bit, Rule30Jen.cell_left_edge]
    · have h := Rule30Diagonals.R_zero t
      simp only [Rule30Diagonals.R, Nat.cast_zero, Int.sub_zero] at h
      simp [x, bit, h]

/-- T004. -/
theorem claim_T004 : (∀ k : Nat, (k ≥ 0) → ((P k) ∣ (Power 2 k))) :=
  by
    intro k _
    show Function.minimalPeriod shift (y k) ∣ 2 ^ k
    apply Function.IsPeriodicPt.minimalPeriod_dvd
    show shift^[2 ^ k] (y k) = y k
    rw [iterate_shift]
    funext t
    simp only [y, Rule30Diagonals.R_periodic]

/-- TC. -/
theorem claim_TC : (∀ T : Nat, (T ≥ 0) → (∀ p : Nat, (p ≥ 1) → (∃ i : Int, ((i ≥ 0) ∧ (i ≤ 1)) ∧ (∃ t : Nat, ((t ≥ T) ∧ (t ≤ ((2 * T) + p))) ∧ ((x i t) ≠ (x i (t + p))))))) :=
  by
    sorry

/-- TD. -/
theorem claim_TD : (∀ T : Nat, (T ≥ 0) → (∀ V : Nat, (V ≥ T) → (((∀ t : Nat, ((t ≥ T) ∧ (t ≤ V)) → ((c t) = 1)) → (V ≤ ((2 * T) + 1))) ∧ ((∀ t : Nat, ((t ≥ T) ∧ (t ≤ V)) → ((c t) = 0)) → (V ≤ ((4 * T) + 5)))))) :=
  by
    sorry

/-- K1. -/
theorem claim_K1 : (¬∃ T : Nat, (T ≥ 0) ∧ (∀ t : Nat, (t ≥ T) → ((c (t + 1)) = (c t)))) :=
  by
    rintro ⟨T, -, h⟩
    exact Rule30Prize.center_not_eventually_period_one ⟨T, fun t ht => bit_inj.mp (h t ht)⟩

/-- F3. -/
theorem claim_F3 : (∀ p : Nat, ((p ≥ 1) ∧ (p ≤ 10000)) → (∀ T : Nat, ((T ≥ 0) ∧ (T ≤ 90000)) → (∃ t : Nat, ((t ≥ T) ∧ (t < (100001 - p))) ∧ ((c (t + p)) ≠ (c t))))) :=
  by
    sorry

/-- H2. -/
theorem claim_H2 : (∀ k : Nat, (k ≥ 3) → ((P k) = (2 * (P (k - 1))))) :=
  by
    sorry

/-- H4. -/
theorem claim_H4 : (∀ k : Nat, (k ≥ 1) → ((P k) ≥ (P (k - 1)))) :=
  by
    sorry

/-- P1. -/
theorem claim_P1 : (¬∃ p : Nat, (p ≥ 1) ∧ (∃ T : Nat, (T ≥ 0) ∧ (∀ t : Nat, (t ≥ T) → ((c (t + p)) = (c t))))) :=
  by
    sorry

/-- P1 (alignment with Ruliology.CellularAutomata.Rule30Prize.Problem1). -/
theorem official_P1 : (¬∃ p : Nat, (p ≥ 1) ∧ (∃ T : Nat, (T ≥ 0) ∧ (∀ t : Nat, (t ≥ T) → ((c (t + p)) = (c t))))) ↔ Ruliology.CellularAutomata.Rule30Prize.Problem1 :=
  by
    unfold Rule30Prize.Problem1 Rule30Jen.EventuallyPeriodic
    constructor
    · rintro h ⟨T, p, hp, hper⟩
      exact h ⟨p, hp, T, Nat.zero_le _, fun t ht => by simp only [c]; rw [hper t ht]⟩
    · rintro h ⟨p, hp, T, -, hper⟩
      exact h ⟨T, p, hp, fun t ht => bit_inj.mp (hper t ht)⟩

/-- H14. -/
theorem claim_H14 : (∀ k : Nat, (k ≥ 1) → ((y k ((P k) / 2)) = 1)) :=
  by
    sorry

/-- TL. -/
theorem claim_TL : ((∀ k : Nat, (k ≥ 3) → ((P k) = ((P (k - 1)) * (1 + (Eps k))))) ∧ (∀ k : Nat, (k ≥ 3) → (∃ j : Nat, (j > k) ∧ ((Eps j) = 1)))) :=
  by
    sorry

/-- TN. -/
theorem claim_TN : (∀ k : Nat, (k ≥ 5) → (¬((((Eps k) = 1) ∧ ((Eps (k - 1)) = 1)) ∧ ((Eps (k - 2)) = 1)))) :=
  by
    sorry

/-- F6. -/
theorem claim_F6 : (∀ p : Nat, ((p ≥ 1) ∧ (p ≤ (Power 2 17))) → (∀ T : Nat, ((T ≥ 0) ∧ (T ≤ 917498)) → (∃ t : Nat, ((t ≥ T) ∧ (t < ((Power 2 20) - p))) ∧ ((c (t + p)) ≠ (c t))))) :=
  by
    sorry

/-- TS. -/
theorem claim_TS : (∀ p : Nat, (p ≥ 1) → (∀ t : Nat, (t ≥ 0) → ((((x 0 t) = (x 0 (t + p))) ∧ ((x 0 (t + 1)) = (x 0 ((t + 1) + p)))) → ((((c t) = 1) → ((x (-1) t) = (x (-1) (t + p)))) ∧ (((c t) = 0) → (((x (-1) t) = (x (-1) (t + p))) ↔ ((x 1 t) = (x 1 (t + p))))))))) :=
  by
    intro p _ t _ hyp
    obtain ⟨h0, h1⟩ := hyp
    have e1 : Rule30Jen.cell (t + 1) 0 = Rule30Jen.rule (Rule30Jen.cell t (-1)) (Rule30Jen.cell t 0) (Rule30Jen.cell t 1) := by
      rw [Rule30Jen.cell]; rfl
    have e2 : Rule30Jen.cell (t + 1 + p) 0 = Rule30Jen.rule (Rule30Jen.cell (t + p) (-1)) (Rule30Jen.cell (t + p) 0) (Rule30Jen.cell (t + p) 1) := by
      rw [show t + 1 + p = (t + p) + 1 by omega, Rule30Jen.cell]; rfl
    simp only [x, c, Rule30Prize.center, bit_inj] at h0 h1 ⊢
    rw [e1, e2] at h1
    revert h0 h1
    generalize Rule30Jen.cell t (-1) = a, Rule30Jen.cell t 0 = b, Rule30Jen.cell t 1 = r,
      Rule30Jen.cell (t + p) (-1) = a', Rule30Jen.cell (t + p) 0 = b', Rule30Jen.cell (t + p) 1 = r'
    cases a <;> cases b <;> cases r <;> cases a' <;> cases b' <;> cases r' <;> simp [Rule30Jen.rule, bit]

/-- TX. -/
theorem claim_TX : (∀ t : Nat, (t ≥ 0) → (((c t) = 1) → ((c (t + 1)) = (1 - (x (-1) t))))) :=
  by
    intro t _ h
    have h' := Rule30MaskedJen.left_of_black t 0 (bit_eq_one.mp h)
    simp only [Int.zero_sub] at h'
    show bit (Rule30Jen.cell (t + 1) 0) = 1 - bit (Rule30Jen.cell t (-1))
    rw [h']
    cases Rule30Jen.cell (t + 1) 0 <;> rfl

end Rule30Ledger
